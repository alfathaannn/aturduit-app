    "hugeicons-react": "^0.4.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "sweetalert2": "^11.16.1",
    "tailwind-merge": "^2.6.0"
